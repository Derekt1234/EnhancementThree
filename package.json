{
  "name": "travlr",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "test": "npm run test:api",
    "test:api": "jest --runInBand app_api --detectOpenHandles",
    "test:angular": "npm --prefix app_admin test -- --watch=false --browsers=ChromeHeadless",
    "test:all": "npm run test:api && npm run test:angular"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "crypto": "^1.0.1",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-jwt": "^8.5.1",
    "hbs": "^4.2.1",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "morgan": "^1.11.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  }
}
